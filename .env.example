# Canonical site URL (no trailing slash). Do not put a temporary IP here.
NUXT_PUBLIC_SITE_URL=https://okna-arsenal24.ru

# true = allow indexing; false = noindex for staging / IP previews
NUXT_PUBLIC_INDEXABLE=false

# Yandex Metrika counter ID (leave empty to disable script)
NUXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional overrides (defaults exist in nuxt.config)
# NUXT_PUBLIC_YANDEX_VERIFICATION=
# NUXT_PUBLIC_GOOGLE_VERIFICATION=

# Telegram (server-only). Rotate token if it was ever committed.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
